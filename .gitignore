# Git ignore configuration for Sauti Android
.env
.env.*
!.env.example

# Android build and gradle
.gradle/
build/
*/build/
*.apk
*.aab

# C++ build artifacts
*.o
*.a
*.so

# Model binaries (weights stored via Git LFS / Hugging Face)
*.gguf
*.bin
*.safetensors
*.pt
*.onnx

# Allow GBNF grammars inside models/
!models/grammars/
!models/grammars/*

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
.cxx/
local.properties

# Python bytecode and cache
__pycache__/
*.py[cod]
