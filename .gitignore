# Git ignore configuration for Sauti Android
.env
.env.*
!.env.example

# Android build and gradle
.gradle/
build/
*/build/
*.apk
*.aab

# C++ build artifacts
*.o
*.a
*.so

# Model binaries (weights stored via Git LFS / Hugging Face)
*.gguf
*.bin
*.safetensors
*.pt
*.onnx
models_store/
benchmarks/audio_test/
encrypted_models_cdn/
developer_r2_readonly.env

# Allow GBNF grammars inside models/
!models/grammars/
!models/grammars/*

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
.cxx/
local.properties

# Python bytecode and cache
__pycache__/
*.py[cod]

# Private grant and competition proposals (never commit to git)
docs/private_grants/
*.private.md

