# Sauti Sovereign Android Platform Environment Configuration
# Strict Zero-Secrets & Safe Environment Loading Policy

# On-Device Offline Speech & Language Models (Tiered Hierarchy)
SAUTI_VOICE_LITE=voice_lite.bin
SAUTI_VOICE_PRO=voice_pro.bin
SAUTI_CORE_LITE=core_lite.bin
SAUTI_CORE_PRO=core_pro.bin
MODEL_HUB_REPO=laphilemon/Sauti-Swahili-Models

# Swahili Nature & Acoustic Voice Personas: MAWIMBI (Default) | NGURUMO | MWANGA
DEFAULT_VOICE_PERSONA=MAWIMBI

# Android Package and Hardware Configuration
ANDROID_PACKAGE_NAME=com.sauti.app
ANDROID_KEYSTORE_ALIAS=SautiSovereignMasterKey
ANDROID_VAULT_ENCRYPTION=AES-256-GCM
ANDROID_TARGET_ABI=arm64-v8a
ANDROID_NDK_OPT=O3_NEON_FAST_MATH

# Sovereign Offline Cryptographic Vault Parameters
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
BIP39_WORD_COUNT=12
