# Cloudflare R2 S3-Compatible API Configuration
# Copy this file to .env and fill in your Cloudflare credentials
# NEVER COMMIT YOUR REAL .env FILE TO VERSION CONTROL

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name_here
CLOUDFLARE_R2_CUSTOM_DOMAIN=https://your_custom_domain_here
