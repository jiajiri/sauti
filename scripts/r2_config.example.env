# ==============================================================================
# Sauti Sovereign Edge-AI Environment Configuration (.env.example)
# NEVER COMMIT YOUR REAL .env FILE TO VERSION CONTROL
# ==============================================================================

# --- Cloudflare R2 Credentials & Distribution CDN ---
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=sauti-models
CLOUDFLARE_R2_CUSTOM_DOMAIN=https://cdn.sauti.ai

# --- Remote Model Weights & Architecture Target Configuration ---
# Zero-Hardcoding: All model paths, filenames, and download URLs are dynamically resolved from environment
MODEL_DIR=models_store

# 1. Swahili ASR Model (Tanzanian Swahili Fine-Tuned Whisper)
MODEL_VOICE_SW_ID=voice_sw
MODEL_VOICE_SW_NAME=JTulel/whisper-swahili-small-q4_1
MODEL_VOICE_SW_SOURCE=models_store/whisper-swahili-small-q4_1.bin
MODEL_VOICE_SW_FILENAME=voice_lite.bin
MODEL_VOICE_SW_TARGET=whisper-swahili-small-q4_1.bin.enc
MODEL_VOICE_SW_REQUIRED=true

# 2. English Voice Companion Model (Base English Whisper)
MODEL_VOICE_EN_ID=voice_en
MODEL_VOICE_EN_NAME=Whisper-Base.en-Q5_1
MODEL_VOICE_EN_SOURCE=models_store/ggml-base.en-q5_1.bin
MODEL_VOICE_EN_FILENAME=voice_en.bin
MODEL_VOICE_EN_TARGET=ggml-base.en-q5_1.bin.enc
MODEL_VOICE_EN_REQUIRED=false

# 3. Primary Bilingual LLM (Google Gemma 3 Swahili + English Fine-Tuned)
MODEL_CORE_PRO_ID=core_pro
MODEL_CORE_PRO_NAME=CraneAILabs/swahili-gemma-1b-GGUF
MODEL_CORE_PRO_SOURCE=models_store/swahili-gemma-1b-q4_k_m.gguf
MODEL_CORE_PRO_FILENAME=core_pro.bin
MODEL_CORE_PRO_TARGET=swahili-gemma-1b-q4_k_m.gguf.enc
MODEL_CORE_PRO_REQUIRED=true

# 4. High-RAM Ultra LLM (Optional 4B Model)
MODEL_CORE_ULTRA_ID=core_ultra
MODEL_CORE_ULTRA_NAME=CraneAILabs/swahili-gemma-4b-GGUF
MODEL_CORE_ULTRA_SOURCE=models_store/swahili-gemma-4b-q4_k_m.gguf
MODEL_CORE_ULTRA_FILENAME=core_ultra.bin
MODEL_CORE_ULTRA_TARGET=swahili-gemma-4b-q4_k_m.gguf.enc
MODEL_CORE_ULTRA_REQUIRED=false
